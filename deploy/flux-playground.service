# systemd user unit for the deployed playground. CI deploys into
# ~/.flux-playground (a symlink swapped on each deploy) and restarts this
# service; see tools/flux-deploy in the flux repo.
#
# Install on the server, as the deploy user:
#   mkdir -p ~/.config/systemd/user
#   cp flux-playground.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now flux-playground.service
#   loginctl enable-linger "$USER"   # keep it running without a login session
[Unit]
Description=Flux playground
After=network-online.target

[Service]
# static/ and examples/ are resolved relative to the working directory.
WorkingDirectory=%h/.flux-playground
# The flux sysroot is deployed to ~/.flux/sysroot, with the flux binary in
# ~/.flux/sysroot/bin. flux runs fixpoint and z3 (also shipped in
# ~/.flux/sysroot/bin) and rustc (the rustup proxy in ~/.cargo/bin) through
# PATH; the user manager's default PATH has none of them.
Environment=PATH=%h/.flux/sysroot/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin
# At most 3 flux runs at a time on the 4-core server, leaving a core for the
# server, nginx, sshd and deploys. A typical run peaks at ~60-130 MB, but
# pathological programs (e.g. z3 blowing up) can use much more.
ExecStart=%h/.flux-playground/flux-playground --flux-path %h/.flux/sysroot/bin/flux --port 3000 --max-concurrent 3
Restart=on-failure

# Resource limits sized for a 2 GB machine, leaving room for the OS, sshd, nginx 
# and deploys. When the limit is hit the kernel kills the largest process in the 
# service (usually a flux or z3 run); the server is restarted if it is the one killed.
MemoryHigh=1G
MemoryMax=1200M
# Kill runaway runs instead of swapping and slowing down the whole machine.
MemorySwapMax=0
TasksMax=256

[Install]
WantedBy=default.target
